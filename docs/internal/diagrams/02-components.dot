// evo CLI + MCP — компоненты (Go-пакеты internal/*). Рёбра — реальные импорты (go list), сгруппированные по слоям.
digraph components {
  graph [rankdir=TB, fontname="Helvetica", fontsize=12, nodesep=0.22, ranksep=0.55, pad=0.3, compound=true, newrank=true];
  node  [fontname="Helvetica", fontsize=10.5, shape=box, style="rounded,filled", margin="0.14,0.06", penwidth=1.1];
  edge  [fontname="Helvetica", fontsize=9.5, color="#5B6B7A", fontcolor="#3B4650", penwidth=1.1, arrowsize=0.7];

  subgraph cluster_entry {
    label="Точки входа"; class="zone"; style="rounded,dashed"; color="#9DB6D6"; fontcolor="#1D4E89";
    evo   [class="surface", fillcolor="#E6F0FB", color="#2F6DB5", label=<<B>cmd/evo</B>>];
    oldvm [class="surface", fillcolor="#E6F0FB", color="#2F6DB5", label=<<B>cmd/cloudru-vm</B><BR/><FONT POINT-SIZE="9">старое имя бинаря</FONT>>];
  }

  subgraph cluster_cli {
    label="internal/cli — поверхность для человека и скриптов (cobra)"; class="surfacezone"; style="rounded,filled"; fillcolor="#F4F8FD"; color="#2F6DB5"; fontcolor="#1D4E89";
    trees  [class="surface", fillcolor="#E6F0FB", color="#2F6DB5", label=<<B>Деревья команд</B><BR/><FONT POINT-SIZE="9">trees.go: vm, disk, vpc, image, k8s, pg, s3, secret<BR/>72 инструмента, флаги из JSON-схемы</FONT>>];
    tcall  [class="surface", fillcolor="#E6F0FB", color="#2F6DB5", label=<<B>evo tools list | describe | call</B><BR/><FONT POINT-SIZE="9">tools.go: все 152, --arg k=v</FONT>>];
    ecmd   [class="surface", fillcolor="#E6F0FB", color="#2F6DB5", label=<<B>Команды движка</B><BR/><FONT POINT-SIZE="9">init, deploy, status, logs, verify,<BR/>destroy: свой код, мимо реестра</FONT>>];
    meta   [class="surface", fillcolor="#E6F0FB", color="#2F6DB5", label=<<B>Служебные</B><BR/><FONT POINT-SIZE="9">configure, whoami, doctor,<BR/>project, marketplace, version</FONT>>];
    mcpcmd [class="surface", fillcolor="#E6F0FB", color="#2F6DB5", label=<<B>evo mcp</B><BR/><FONT POINT-SIZE="9">--http, --toolsets, --allow-project,<BR/>healthcheck</FONT>>];
  }

  subgraph cluster_mcp {
    label="internal/mcp — поверхность для агентов (JSON-RPC 2.0, ответы на английском)"; class="surfacezone"; style="rounded,filled"; fillcolor="#F4F8FD"; color="#2F6DB5"; fontcolor="#1D4E89";
    stdio  [class="surface", fillcolor="#E6F0FB", color="#2F6DB5", label=<<B>stdio-сервер</B><BR/><FONT POINT-SIZE="9">server.go: tools/list, tools/call,<BR/>stdout = только протокол</FONT>>];
    http   [class="surface", fillcolor="#E6F0FB", color="#2F6DB5", label=<<B>Streamable HTTP</B><BR/><FONT POINT-SIZE="9">http.go: Bearer, сессии 24 ч, SSE,<BR/>≤32 вызова, ≤100 в пакете</FONT>>];
    policy [class="guard", fillcolor="#FDECEA", color="#C0392B", label=<<B>HTTP-политика</B><BR/><FONT POINT-SIZE="9">http_policy, http_paths, http_kube:<BR/>маскирование секретов, фильтр kubectl/helm,<BR/>пути к файлам хоста закрыты</FONT>>];
    cancel [class="surface", fillcolor="#E6F0FB", color="#2F6DB5", label=<<B>Отмена</B><BR/><FONT POINT-SIZE="9">cancel.go: in-flight</FONT>>];
  }

  subgraph cluster_core {
    label="Ядро: один набор обработчиков для CLI и MCP"; class="corezone"; style="rounded,filled"; fillcolor="#FFFBEF"; color="#B7860B"; fontcolor="#7A5900";
    tools   [class="core", fillcolor="#FFF4D6", color="#B7860B", label=<<B>internal/tools — реестр</B><BR/><FONT POINT-SIZE="9">152 инструмента · 23 группы · 65 изменяющих<BR/>имя, схема, обработчик map[string]any → JSON<BR/>argcheck, namecheck, opwait, delete_preview</FONT>>];
    confirm [class="core", fillcolor="#FFF4D6", color="#B7860B", label=<<B>internal/confirm</B><BR/><FONT POINT-SIZE="9">единая модель согласия:<BR/>превью → y/д | --yes | confirmed=true<BR/>иначе код 3, не успех</FONT>>];
  }

  subgraph cluster_domain {
    label="Оркестрация и предметная логика"; class="domainzone"; style="rounded,filled"; fillcolor="#F3FAF5"; color="#2E8B57"; fontcolor="#1F6640";
    engine  [class="domain", fillcolor="#EAF6EE", color="#2E8B57", label=<<B>engine</B><BR/><FONT POINT-SIZE="9">сценарий compose → ВМ:<BR/>init, preview, deploy, destroy, logs</FONT>>];
    dplan   [class="domain", fillcolor="#EAF6EE", color="#2E8B57", label=<<B>deployplan</B><BR/><FONT POINT-SIZE="9">Resolve → Plan с ценой → Apply<BR/>deploy_plan / deploy_apply</FONT>>];
    stack   [class="domain", fillcolor="#EAF6EE", color="#2E8B57", label=<<B>stack</B><BR/><FONT POINT-SIZE="9">машина состояний на диске:<BR/>PG + ВМ + NLB + секреты + S3</FONT>>];
    mkt     [class="domain", fillcolor="#EAF6EE", color="#2E8B57", label=<<B>marketplace · images</B><BR/><FONT POINT-SIZE="9">витрина ОС, продуктов и<BR/>плагинов k8s (только чтение)</FONT>>];
    pricing [class="domain", fillcolor="#EAF6EE", color="#2E8B57", label=<<B>pricing</B><BR/><FONT POINT-SIZE="9">price-calculation API,<BR/>иначе оценка по таблице</FONT>>];
    sizing  [class="domain", fillcolor="#EAF6EE", color="#2E8B57", label=<<B>sizer · compose · sgrules</B><BR/><FONT POINT-SIZE="9">flavor по compose, порты → SG</FONT>>];
    sshdep  [class="domain", fillcolor="#EAF6EE", color="#2E8B57", label=<<B>deploy · bootstrap · verify</B><BR/><FONT POINT-SIZE="9">SSH, установка Docker,<BR/>HTTP-проверка портов</FONT>>];
    kube    [class="domain", fillcolor="#EAF6EE", color="#2E8B57", label=<<B>kubetools</B><BR/><FONT POINT-SIZE="9">kubectl/helm с kubeconfig<BR/>во временном файле</FONT>>];
  }

  subgraph cluster_clients {
    label="Клиенты сервисов Cloud.ru (REST + Bearer IAM)"; class="clientzone"; style="rounded,filled"; fillcolor="#F6F8FA"; color="#5B6B7A"; fontcolor="#3B4650";
    prov  [class="client", fillcolor="#EEF1F4", color="#5B6B7A", label=<<B>provision</B><BR/><FONT POINT-SIZE="9">compute: ВМ, диски, образы,<BR/>FIP, SG, SNAT, квоты, цена</FONT>>];
    net   [class="client", fillcolor="#EEF1F4", color="#5B6B7A", label=<<B>vpc · nlb · dns</B>>];
    mk8s  [class="client", fillcolor="#EEF1F4", color="#5B6B7A", label=<<B>mk8s</B><BR/><FONT POINT-SIZE="9">кластеры, пулы, плагины,<BR/>kubeconfig</FONT>>];
    dbs   [class="client", fillcolor="#EEF1F4", color="#5B6B7A", label=<<B>postgresql · dbaas</B><BR/><FONT POINT-SIZE="9">dbaas = Kafka + Redis</FONT>>];
    store [class="client", fillcolor="#EEF1F4", color="#5B6B7A", label=<<B>s3 · secret · certmanager</B>>];
    paas  [class="client", fillcolor="#EEF1F4", color="#5B6B7A", label=<<B>containerapp · artifact</B>>];
    obs   [class="client", fillcolor="#EEF1F4", color="#5B6B7A", label=<<B>monitoring · audit · billing</B><BR/><FONT POINT-SIZE="9">только чтение</FONT>>];
  }

  subgraph cluster_x {
    label="Сквозные пакеты: используют все слои выше"; class="infrazone"; style="rounded,dashed"; color="#A7A79C"; fontcolor="#5E5E55";
    auth   [class="infra", fillcolor="#F6F6F4", color="#8A8A80", label=<<B>auth</B><BR/><FONT POINT-SIZE="9">IAM-токен, кэш, keygen</FONT>>];
    retry  [class="infra", fillcolor="#F6F6F4", color="#8A8A80", label=<<B>httpretry · product</B><BR/><FONT POINT-SIZE="9">повтор 429/5xx на чтениях,<BR/>User-Agent evo/…</FONT>>];
    config [class="infra", fillcolor="#F6F6F4", color="#8A8A80", label=<<B>config · state</B><BR/><FONT POINT-SIZE="9">флаги &gt; env &gt; .evo.yaml &gt; профиль;<BR/>state.json + lock</FONT>>];
    errs   [class="infra", fillcolor="#F6F6F4", color="#8A8A80", label=<<B>errors · i18n · log · output</B><BR/><FONT POINT-SIZE="9">коды выхода, RU/EN,<BR/>санитайзер логов, pager</FONT>>];
  }

  evo -> mcpcmd [lhead=cluster_cli]; oldvm -> mcpcmd [lhead=cluster_cli, style=dashed];

  trees -> tools [label="вызов обработчика"];
  tcall -> tools;
  ecmd  -> engine [label="напрямую"];
  mcpcmd -> stdio [label="без --http"];
  mcpcmd -> http  [label="--http"];
  http -> policy [label="оборачивает\nобработчики"];
  stdio -> tools [label="tools/call"];
  policy -> tools;
  http -> cancel [arrowhead=none, style=dotted];

  trees -> confirm [style=dashed, label="Ask"];
  tcall -> confirm [style=dashed];
  ecmd -> confirm [style=dashed];
  tools -> confirm [style=dashed, label="изменяющие → превью", constraint=false];

  tools -> engine; tools -> dplan; tools -> stack; tools -> mkt; tools -> kube;
  engine -> dplan [constraint=false];
  engine -> pricing; engine -> sizing; engine -> sshdep;
  dplan -> pricing [constraint=false];

  tools -> net  [lhead=cluster_clients, label="остальные группы: прямой вызов клиента"];
  engine -> prov; dplan -> prov; stack -> prov; mkt -> mk8s; kube -> mk8s [style=dotted, label="kubeconfig"];

  { rank=same; trees; tcall; ecmd; meta; mcpcmd; }
  { rank=same; stdio; http; cancel; }
  { rank=same; tools; confirm; }
  { rank=same; engine; dplan; stack; mkt; kube; }
  { rank=same; pricing; sizing; sshdep; }
  { rank=same; prov; net; mk8s; dbs; store; paas; obs; }
  { rank=same; auth; retry; config; errs; }
  dbs -> retry [ltail=cluster_clients, lhead=cluster_x, style=dotted, arrowhead=none, label="токен, повторы, ошибки, i18n"];
}

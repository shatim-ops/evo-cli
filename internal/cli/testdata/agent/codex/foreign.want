model = "o3"
approval_policy = "on-request"

[mcp_servers.github]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-github"]

[mcp_servers.github.env]
LOG_LEVEL = "info"

[mcp_servers.evo]
command = "evo"
args = ["mcp", "--toolsets", "deploy,vm,vpc,disk,image"]

# Profiles.
[profiles.fast]
model = "o4-mini"

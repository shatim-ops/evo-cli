# Маска для публичных логов cloud-e2e (репозиторий открыт): ID, IP и имена
# групп безопасности и подсетей тестового проекта. Стандартные имена Cloud.ru
# (Default_<зона>, SSH-access_<зона>, default_<зона>) остаются — по ним видно,
# что выбрал evo. Вызов: sed -E -f .github/scripts/redact.sed (GNU sed
# раннеров Linux: \b — его расширение); проверка — .github/scripts/redact_test.sh
# (job ci).
#
# Пароль ВМ (FB122-1, дельта-аудит Fable 1.2.2): с 1.2.2 конверт ошибки
# --json несёт details.password, а текст ошибки — строку «Пароль ВМ: …».
# Первыми: правила ниже режут куски пароля, а не весь. Значение JSON — до
# закрывающей кавычки с учётом «\"»; в строке текста пароль evo без пробелов.
s/"([A-Za-z_]*password)"[[:space:]]*:[[:space:]]*"([^"\\]|\\.)*"/"\1":"<password>"/g
s/(Пароль ВМ|VM password): [^ ]+/\1: <password>/g
# UUID вместе с приклеенным хвостом из hex-цифр («…6666ab» не оставляет
# «ab»); хвост через «-» или «_» («<id>-boot») — не ID и остаётся.
s/[0-9a-fA-F]*[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}[0-9a-fA-F]*/<id>/g
s/([0-9]{1,3}\.){3}[0-9]{1,3}/<ip>/g
# IPv6 (аудит безопасности 19.10, SEC-6). Время «21:07:13» и таймстемпы
# GitHub «2026-10-19T21:07:13.4332220Z» на IPv6 похожи, поэтому маскируется
# только то, что ими быть не может: с «::» и хотя бы одной группой
# («2001:db8::1», «::1», «fe80::», «2001:db8::/32») или из трёх групп и
# больше, среди которых есть группа с буквой a-f («2001:db8:0:0:1:2:3:4»),
# или из восьми групп.
# Перед адресом — не буква, не цифра и не «:»: «T21:07» и «std::x» — не адреса.
s/(^|[^0-9A-Za-z:])(([0-9a-fA-F]{1,4}:)*[0-9a-fA-F]{1,4})?::[0-9a-fA-F]{1,4}(:[0-9a-fA-F]{1,4})*\b/\1<ipv6>/g
s/(^|[^0-9A-Za-z:])([0-9a-fA-F]{1,4}:)*[0-9a-fA-F]{1,4}::([^0-9A-Za-z:]|$)/\1<ipv6>\3/g
s/(^|[^0-9A-Za-z:])(([0-9a-fA-F]{1,4}:){2,}([a-fA-F][0-9a-fA-F]{0,3}|[0-9a-fA-F][a-fA-F][0-9a-fA-F]{0,2}|[0-9a-fA-F]{2}[a-fA-F][0-9a-fA-F]?|[0-9a-fA-F]{3}[a-fA-F])(:[0-9a-fA-F]{1,4})*|[0-9a-fA-F]{1,4}:([a-fA-F][0-9a-fA-F]{0,3}|[0-9a-fA-F][a-fA-F][0-9a-fA-F]{0,2}|[0-9a-fA-F]{2}[a-fA-F][0-9a-fA-F]?|[0-9a-fA-F]{3}[a-fA-F])(:[0-9a-fA-F]{1,4})+|([a-fA-F][0-9a-fA-F]{0,3}|[0-9a-fA-F][a-fA-F][0-9a-fA-F]{0,2}|[0-9a-fA-F]{2}[a-fA-F][0-9a-fA-F]?|[0-9a-fA-F]{3}[a-fA-F])(:[0-9a-fA-F]{1,4}){2,})\b/\1<ipv6>/g
# Полная форма из восьми групп — адрес и без букв («2001:0:0:0:0:0:0:1»,
# break r4, R4-13): время и версии восьми групп не дают.
s/(^|[^0-9A-Za-z:])([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}([^0-9A-Za-z:]|$)/\1<ipv6>\3/g
# hex-ID и токены от 32 цифр (реестры, ключи; 64 — «openssl rand -hex 32»,
# так советуют делать MCP_BEARER_TOKEN, break r4, R4-13) и адреса ресурсов:
# реестр Artifact Registry и endpoint кластера Kubernetes называют ресурс
# (release audit, A-016). ID, приклеенный через «_» («reg_<32hex>»,
# «<32hex>_x»), \b не отделяет: «_» — буква слова. Ровно 40 цифр — хэш
# коммита публичного репозитория, не ID, и остаётся; короткие хэши и версии
# короче 32 цифр не задеваются.
s/\b([0-9a-fA-F]{32,39}|[0-9a-fA-F]{41,})\b/<id>/g
s/_([0-9a-fA-F]{32,39}|[0-9a-fA-F]{41,})_/_<id>_/g
s/_([0-9a-fA-F]{32,39}|[0-9a-fA-F]{41,})\b/_<id>/g
s/\b([0-9a-fA-F]{32,39}|[0-9a-fA-F]{41,})_/<id>_/g
# Имена хостов — без учёта регистра (флаг I GNU sed): DNS его не различает,
# «MyApp.Containers.Cloud.RU» — тот же ресурс (R4-13), «Console.cloud.ru» —
# тот же публичный хост (R4-14). В имени бывает «_» («my_bucket»).
s/[A-Za-z0-9_-]+\.cr\.cloud\.ru/<registry>.cr.cloud.ru/gI
s/[A-Za-z0-9_.-]+\.mk8s\.[A-Za-z0-9_.-]+/<host>/gI
# Прочие поддомены cloud.ru называют ресурс: бакет («<bucket>.s3.cloud.ru»),
# приложение, кластер (SEC-6). Публичные хосты API и входа, которые evo
# зовёт сам (internal/: *.api.cloud.ru, id.cloud.ru, auth.iam.cloud.ru,
# console.cloud.ru, s3.cloud.ru; cloud.ru без поддомена не задевается),
# сначала помечаются «@@» и остаются; метку снимает последняя строка.
# Перед публичным хостом — не часть имени: «my_s3.cloud.ru» — не s3.cloud.ru.
s/(^|[^A-Za-z0-9_.-])((id|auth\.iam|console|s3|[a-z0-9-]+\.api)\.cloud\.ru)/\1@@\2/gI
s/(^|[^@A-Za-z0-9_.-])[A-Za-z0-9_.-]+\.s3\.cloud\.ru/\1<bucket>.s3.cloud.ru/gI
s/(^|[^@A-Za-z0-9_.-])([A-Za-z0-9_-]+\.)+cloud\.ru/\1<host>.cloud.ru/gI
# Список групп зоны: «несколько групп безопасности (a, b)».
s/(безопасности) \([^)]*\)/\1 (<names>)/g
# Стандартное имя целиком, до разделителя: «SSH-access_ru.AZ-1-web» — не оно.
s/(безопасности|подсеть|подсети|взята) (Default|SSH-access|default)_(ru\.AZ-[0-9]+)([ ,;.:)]|$)/\1 @@\2_\3\4/g
# Слова текста после «группа безопасности» / «подсеть» — не имена.
s/(безопасности|подсеть|подсети) (для|в|во|не|нет|по|с|из|и|у|к|на|новой|ВМ|зоны|зоне|общая|есть|проекта|проекте)([ ,;.:)]|$)/\1 @@\2\3/g
s/(безопасности|подсеть|подсети|взята) ([^@ ,;:()][^ ,;:()]*)/\1 <name>/g
s/@@//g

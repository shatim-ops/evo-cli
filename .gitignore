/evo
/cloudru-vm
/cloudru-vm-*
*.bak-*
.DS_Store

# Рабочее состояние движка: приватный ключ доступа к сборочным ВМ
# (.cloudru-vm/ — старое имя, читается до v1.1).
.evo/
.cloudru-vm/
# Собранный бинарь
/bin/

# Креды. Движок ходит в облако от имени сервисного аккаунта: утёкший ключ
# даёт создание ВМ, дисков и образов за чужой счёт.
.env
.env.*
!.env.example
*.pem
*.key
credentials
credentials.yaml
# Профиль cloud-e2e (CLOUDRU_CONFIG_DIR в workflow).
.e2e-config/

# Вывод goreleaser
/dist/
# Байткод Python (scripts/*.py).
__pycache__/
.cache/
